# Copy this file to .env (never commit .env).
# Find these in ai.azure.com: your project's Home page and Build > Models.
FOUNDRY_PROJECT_ENDPOINT=https://timsheldonoure1-7020-resource.services.ai.azure.com/api/projects/timsheldonoure1-7020
FOUNDRY_MODEL_DEPLOYMENT=matchday-mini
# agent = call the registered Foundry agents (run `npm run crew:deploy` first); direct = call the model
MATCHDAY_AGENT_MODE=agent

# Voice (Azure AI Speech). Region of your Foundry resource, e.g. eastus2 or swedencentral:
#   az cognitiveservices account show -n timsheldonoure1-7020-resource -g rg-timsheldonoure1-7401 --query location -o tsv
SPEECH_REGION=
SPEECH_RESOURCE_ID=/subscriptions/09a3fff5-1ca4-4e8f-8798-0bcc319d8375/resourceGroups/rg-timsheldonoure1-7401/providers/Microsoft.CognitiveServices/accounts/timsheldonoure1-7020-resource
# Optional fallback if Entra ID auth is not set up for Speech (the "API key" on your Foundry home page):
# SPEECH_KEY=
