{
  "name": "matchday-crew",
  "version": "0.1.0",
  "description": "Synthetic football match event generator for the Matchday Crew multi-agent project",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node src/cli.js generate --seed 42",
    "stats": "node src/cli.js stats --seed 42",
    "stream": "node src/cli.js stream --seed 42 --speed 30",
    "calibrate": "node src/cli.js calibrate --n 200",
    "serve": "node src/server.js",
    "test": "node --test test/*.test.js",
    "crew:check": "node src/crew-cli.js check",
    "crew:deploy": "node src/crew-cli.js deploy",
    "crew:live": "node src/crew-cli.js live --seed 42 --speed 40 --langs en,sw,ja",
    "crew:offline": "node src/crew-cli.js live --seed 42 --speed 200 --offline"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/ai-projects": "^2.8.0",
    "@azure/identity": "^4.13.3"
  }
}
